# Optional: turns on AI features powered by Groq (place enrichment, dietary-aware
# restaurant picks, filming-location search for any title, future-trip ideas).
# Get a free key at https://console.groq.com/keys — everything else works without it.
GROQ_API_KEY=
# Optional model override (default: openai/gpt-oss-120b; must support strict structured outputs)
GROQ_MODEL=

# Where accounts, trips and shared group trips are stored (JSON files). Use a persistent disk in production.
DATA_DIR=.data

# Port for `npm start` (production server)
PORT=3000
